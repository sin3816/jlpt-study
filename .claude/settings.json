{
  "permissions": {
    "allow": [
      "Bash(npm run validate)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm start)",
      "Bash(node scripts/validate-content.js:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.js\"", "timeout": 60 }
        ]
      }
    ]
  }
}
